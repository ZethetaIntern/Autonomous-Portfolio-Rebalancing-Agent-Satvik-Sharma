# ==============================================================================
# WealthPilot AI - Environment Configuration
# Project 1D: Autonomous Portfolio Rebalancing Agent with Explainable Decisions
# ==============================================================================

# System Environment
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=True

# LLM & Agent Framework Providers (For Days 7+)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MODEL_NAME=gpt-4o-mini

# Market Data Simulator & Storage
MARKET_DATA_SEED=42
DATA_DIR=./data
CONFIG_DIR=./config
CACHE_DIR=./.cache

# SLA & Vectorized Performance Limits
PORTFOLIO_COUNT_DEFAULT=50000
MAX_DRIFT_SCAN_SLA_SECONDS=30.0
VECTORIZED_BATCH_SIZE=10000

# Streamlit Cockpit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Compliance & Audit Settings
AUDIT_LOG_ENABLED=True
REGULATORY_JURISDICTION=SEBI_INDIA
TAX_REGIME=IN_FY2025_2026
LTCG_EXEMPTION_LIMIT_INR=125000
